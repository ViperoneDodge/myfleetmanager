rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'appmyfleetmanager@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /unlock/{code} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /pro/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.revoked == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.revoked == resource.data.revoked);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /fleets/{fleetId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && (request.resource.data.personal != true || fleetId == request.auth.uid);

      allow update: if isMember() || (
        signedIn()
        && resource.data.personal != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberEmails'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /vehicles/{vehicleId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/fleets/$(fleetId)).data.members;
      }
    }
  }
}
