rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'appmyfleetmanager@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /unlock/{code} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /pro/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.revoked == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.revoked == resource.data.revoked);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /{path=**}/vehicles/{vehicleId} {
      allow read: if isAdmin();
    }

    match /fleets/{fleetId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function adminsOf(d) {
        return d.get('admins', []).concat([d.ownerUid]);
      }

      function isGroupAdmin() {
        return isMember()
          && (resource.data.get('personal', false) == true || request.auth.uid in adminsOf(resource.data));
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && (request.resource.data.personal != true || fleetId == request.auth.uid);

      allow update: if isAdmin()
        || (isGroupAdmin()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.get('admins', []).hasAll(resource.data.get('admins', []))
          && request.resource.data.members.hasAll(adminsOf(resource.data)))
        || (isMember()
          && request.auth.uid != resource.data.ownerUid
          && changed().hasOnly(['members', 'memberEmails', 'viewers', 'admins'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
          && request.resource.data.get('admins', []).hasAll(resource.data.get('admins', []).removeAll([request.auth.uid]))
          && request.resource.data.get('viewers', []).hasAll(resource.data.get('viewers', []).removeAll([request.auth.uid])))
        || (signedIn()
          && !isMember()
          && resource.data.get('personal', false) != true
          && changed().hasOnly(['members', 'memberEmails', 'viewers'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
          && request.auth.uid in request.resource.data.viewers
          && request.resource.data.viewers.removeAll(resource.data.get('viewers', [])).hasOnly([request.auth.uid]));

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /docs/{docId} {
        function fd() {
          return get(/databases/$(database)/documents/fleets/$(fleetId)).data;
        }

        function member() {
          return signedIn() && request.auth.uid in fd().members;
        }

        function editor() {
          return member()
            && (request.auth.uid == fd().ownerUid
              || request.auth.uid in fd().get('admins', [])
              || !(request.auth.uid in fd().get('viewers', [])));
        }

        function sharing() {
          return fd().get('personal', false) == true || fd().get('shareDocs', false) == true;
        }

        allow read: if isAdmin() || member();
        allow create: if editor() && sharing()
          && request.resource.data.by == request.auth.uid
          && request.resource.data['size'] is int
          && request.resource.data['size'] <= 1048576;
        allow update: if editor()
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            || (sharing()
              && resource.data.by == request.auth.uid
              && request.resource.data.by == request.auth.uid
              && request.resource.data['size'] is int
              && request.resource.data['size'] <= 1048576));
        allow delete: if isAdmin() || editor();

        match /data/{part} {
          allow read: if isAdmin() || member();
          allow create, update: if editor() && sharing()
            && request.resource.data.b64 is string
            && request.resource.data.b64.size() < 1000000;
          allow delete: if isAdmin() || editor();
        }
      }

      match /vehicles/{vehicleId} {
        function fleet() {
          return get(/databases/$(database)/documents/fleets/$(fleetId)).data;
        }

        allow read: if isAdmin() || (signedIn() && request.auth.uid in fleet().members);
        allow write: if isAdmin() || (signedIn()
          && request.auth.uid in fleet().members
          && (request.auth.uid == fleet().ownerUid
            || request.auth.uid in fleet().get('admins', [])
            || !(request.auth.uid in fleet().get('viewers', []))));
      }
    }
  }
}
